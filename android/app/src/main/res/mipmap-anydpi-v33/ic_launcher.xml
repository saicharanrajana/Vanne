<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ (API 33) adds the themed-icon layer. Kept in a -v33 resource so
     pre-33 parsers never see an element they do not understand. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- The launcher tints this mask with wallpaper/theme colours; the white
         normal-icon background above does not apply to themed icons. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
